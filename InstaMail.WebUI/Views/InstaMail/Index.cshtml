@model InstaMail.EntityLayer.Entity.InstaMail

@{
    ViewData["Title"] = "InstaMail - Geçici E-Posta Hizmeti";
}

<main>
    <article id="mail-create">
        <div class="caption container col-12 col-lg-6 d-flex flex-column text-center">
            <h1 class="title">
                <img src="~/img/mails.png" alt="Logo" width="40" height="40" class="me-2">
                <span class="modern-title">InstaMail</span>
            </h1>
            <p class="desc">Geçici E-Posta Adresi Oluşturun</p>
        </div>
        <div class="container col-12 col-lg-6 d-flex flex-column flex-lg-row align-items-center justify-content-center gap-2">
            <div class="mail col-12 col-lg-10">@Model?.EmailAddress</div>
            <a href="#" class="mail-icon col-5 col-lg-2" onclick="copyEmail()">
                <i class="bi bi-copy me-2"></i>Kopyala
            </a>
            @using (Html.BeginForm("CreateEmail", "InstaMail", FormMethod.Post, new { @class = "d-inline col-5 col-lg-2 mail-icon" }))
            {
                <button type="submit" style="background-color: transparent;border:none;">
                    <i class="bi bi-envelope me-2"></i>Yeni
                </button>
            }
        </div>
    </article>

    
        @if (Model != null)
        {
        <article id="mail-box" class="col-12" @(Model == null ? "style='display:none;'" : "")>
            <div class="wrapper container col-lg-7 d-flex gap-2">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Gönderen</th>
                        <th scope="col">Konu</th>
                        <th scope="col">Alınma Zamanı</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model != null && Model.EmailMessages.Any())
                    {
                        foreach (var message in Model.EmailMessages)
                        {
                            <tr>
                                <th scope="row">@message.ID</th>
                                <td>@message.Sender</td>
                                <td>@message.Subject</td>
                                <td>@message.Time.ToString("g")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="py-4 text-muted text-center">
                                <div class="d-flex align-items-center justify-content-center flex-column">
                                     <strong>📭 Önemli Bilgilendirme:</strong><br><br>
                                    Şu an için web sitemizde aktif bir e-posta sunucusu bulunmadığından, <br>
                                    üretilen e-posta adreslerine gelen mailler alınamamaktadır. <br><br>
                                    Ancak, oluşturduğunuz e-posta adresleri sayesinde <br>
                                    çeşitli web sitelerine güvenli bir şekilde üye olabilirsiniz. <br><br>
                                    Anlayışınız için teşekkür ederiz.
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
        }
        
    
    

    <div class="container col-lg-7 d-flex flex-column gap-2 my-5">
        <h2 class="text-center fw-bold mb-3">InstaMail: Geçici E-Posta Adresi Oluşturun</h2>
        <h3>Geçici E-Posta Adresi Nedir?</h3>
        <p>
            Geçici e-posta adresi, kısa süreli kullanım için oluşturulan, geçici
            ve anonim bir e-posta adresidir. Bu tür adresler, kişisel e-posta
            bilgilerinizi paylaşmadan çeşitli web sitelerine üye olmanızı sağlar.
            InstaMail, hızlı ve güvenli bir şekilde geçici e-posta adresi
            oluşturmanıza yardımcı olur.
        </p>
        <h3>InstaMail'in Avantajları</h3>
        <ul>
            <li><strong>Anında Oluşturma:</strong> Tek tıkla anında geçici e-posta adresinizi oluşturabilirsiniz.</li>
            <li><strong>Gizlilik:</strong> Kişisel e-posta adresinizi paylaşmadan web sitelerine kayıt olabilirsiniz.</li>
            <li><strong>Spam Koruması:</strong> Geçici e-posta adresleri, spam ve gereksiz e-postalardan korunmanızı sağlar.</li>
            <li><strong>Ücretsiz Hizmet:</strong> InstaMail, tamamen ücretsiz ve sınırsız kullanım imkanı sunar.</li>
        </ul>
        <img class="img-fluid w-75 mx-auto" src="~/instamail/assets/images/avantages.png" alt="Avantajları" />

        <h3>Geçici E-Posta Adresi Kullanım Alanları</h3>
        <ul>
            <li>Web sitelerine üye olurken</li>
            <li>Forumlara veya bloglara yorum yaparken</li>
            <li>Online kampanyalara katılırken</li>
            <li>Dosya indirme işlemlerinde</li>
        </ul>
        <img class="img-fluid w-75 mx-auto" src="~/instamail/assets/images/kullanim.png" alt="Kullanım Alanları" />

        <h3>InstaMail Nasıl Kullanılır?</h3>
        <ol>
            <li>InstaMail web sitesine girin.</li>
            <li>"Geçici E-Posta Adresi Oluştur" butonuna tıklayın.</li>
            <li>Oluşturulan geçici e-posta adresini kopyalayın ve dilediğiniz yerde kullanın.</li>
            <li>Gelen kutusundan e-postalarınızı anında görüntüleyin.</li>
        </ol>

        <p><strong>Hemen InstaMail'i deneyin ve geçici e-posta adresi oluşturmanın pratik yolunu keşfedin!</strong></p>
    </div>

    <section id="copyright" class="col-12">
        <p class="mb-0">© 2025 InstaMail | Tüm Hakları Saklıdır.</p>
    </section>
</main>

<script>
  function copyEmail() {
    const email = "@Model?.EmailAddress";
    navigator.clipboard.writeText(email).then(() => {
      alert("E-posta adresi kopyalandı: " + email);
    });
  }
</script>